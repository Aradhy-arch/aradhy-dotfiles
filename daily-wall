#!/usr/bin/env bash

WALL_DIR="$HOME/Pictures/Wallpapers"
STATE_FILE="$HOME/.cache/wallpaper_index"

# Gather all image files
mapfile -d '' FILES < <(find "$WALL_DIR" -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" \) -print0 | sort -z)

TOTAL=${#FILES[@]}
[ "$TOTAL" -eq 0 ] && exit 1

# Read previous index
INDEX=0
if [ -f "$STATE_FILE" ]; then
    INDEX=$(cat "$STATE_FILE")
    INDEX=$(( (INDEX + 1) % TOTAL ))
fi

# Save new index
echo "$INDEX" > "$STATE_FILE"
CHOSEN="${FILES[$INDEX]}"

# ONLY change the wallpaper and update hyprpaper.conf (Do NOT run wallust)
hyprctl hyprpaper preload "$CHOSEN" >/dev/null 2>&1
hyprctl hyprpaper wallpaper ",$CHOSEN" >/dev/null 2>&1
hyprctl hyprpaper unload all >/dev/null 2>&1 || true

cat << EOF > "$HOME/.config/hypr/hyprpaper.conf"
wallpaper {
    monitor =
    path = $CHOSEN
    fit_mode = cover
}
splash = false
EOF
