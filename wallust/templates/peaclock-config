# peaclock config — generated by wallust, layout settings below are yours to edit
# -----------------------------------------------------------------------------
# general
# -----------------------------------------------------------------------------
block 2 1
padding 0 0
margin 0 0
ratio 2 1
date-padding 1
fill ''
locale ''
timezone ''
date '%a %b %d'
mode clock
view digital
toggle active-bg
stopwatch start
timer 10m:0s
timer-exec 'notify-send -a peaclock "timer complete"'
rate-input 50
rate-refresh 1000
rate-status 5000

# -----------------------------------------------------------------------------
# toggles
# -----------------------------------------------------------------------------
set hour-24 on
set seconds off
set date on
set auto-size on
set auto-ratio on

# -----------------------------------------------------------------------------
# styles — driven by wallust
# -----------------------------------------------------------------------------
style active-fg {{background}}
style inactive-fg {{color8}}
style colon-fg {{color8}}
style active-bg {{color4}}
style inactive-bg {{background}}
style colon-bg {{background}}
style date {{foreground}}
style background {{background}}
style text {{foreground}}
style prompt {{color4}}
style success green
style error red
