# peaclock config — generated by wallust, layout settings below are yours to edit
# -----------------------------------------------------------------------------
# general
# -----------------------------------------------------------------------------
block 2 1
padding 0 0
margin 0 0
ratio 2 1
date-padding 1
fill ''
locale ''
timezone ''
date '%a %b %d'
mode clock
view digital
toggle active-bg
stopwatch start
timer 10m:0s
timer-exec 'notify-send -a peaclock "timer complete"'
rate-input 50
rate-refresh 1000
rate-status 5000

# -----------------------------------------------------------------------------
# toggles
# -----------------------------------------------------------------------------
set hour-24 on
set seconds off
set date on
set auto-size on
set auto-ratio on

# -----------------------------------------------------------------------------
# styles — driven by wallust
# -----------------------------------------------------------------------------
style active-fg #090303
style inactive-fg #BC6674
style colon-fg #BC6674
style active-bg #6F3D4E
style inactive-bg #090303
style colon-bg #090303
style date #FFB3C3
style background #090303
style text #FFB3C3
style prompt #6F3D4E
style success green
style error red
